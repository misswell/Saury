<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud 同步：把这份 entitlements 挂到主 target（CODE_SIGN_ENTITLEMENTS）
	     并在 SWIFT_ACTIVE_COMPILATION_CONDITIONS 里加 SAURY_ICLOUD 之后，
	     「iCloud 与数据」页的同步才会真正启用。 -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.guofeng.saury</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore</key>
	<true/>
</dict>
</plist>
