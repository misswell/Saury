<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 备用 App 图标：设置-外观里可切换 自动/浅色/深色。
	     基础键（显示名、版本号等）仍由 GENERATE_INFOPLIST_FILE 注入。 -->
	<key>CFBundleAlternateIcons</key>
	<dict>
		<key>AppIconLight</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIconLight</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<true/>
		</dict>
		<key>AppIconDark</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIconDark</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<true/>
		</dict>
	</dict>
	<!-- 完整备份包：带清单的压缩容器（见 BackupContainer），扩展名 .saurybackup。
	     必须在这里登记 UTI，否则「分享」出去的包在文件 App 里只是个未知类型，
	     也选不回本 App 恢复。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>期见完整备份</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.guofeng.saury.backup</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>期见完整备份</string>
			<key>UTTypeIdentifier</key>
			<string>com.guofeng.saury.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>saurybackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
